{
  "name": "revit-mcp-server",
  "version": "0.9.0",
  "description": "MCP server (stdio) that bridges Claude Desktop to a Revit addin via HTTP.",
  "private": true,
  "type": "module",
  "bin": {
    "revit-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --config ./vitest.config.ts --root .",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
